{
  "name": "ts-dspy-monorepo",
  "version": "0.4.2",
  "private": true,
  "description": "TypeScript framework for building type-safe LLM applications with structured outputs, ReAct reasoning patterns, and runtime validation",
  "author": "Arnav Dadarya",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:providers",
    "build:core": "npm run build -w @ts-dspy/core",
    "build:providers": "npm run build -w @ts-dspy/openai -w @ts-dspy/gemini -w @ts-dspy/anthropic",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run build:core && npm run typecheck --workspaces",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "clean": "npm run clean --workspaces",
    "release": "npm run build && changeset publish",
    "chart:downloads": "node scripts/generate-downloads-chart.js",
    "example:openai": "tsx examples/basic-usage.ts",
    "example:gemini": "tsx examples/basic-gemini-example.ts",
    "example:anthropic": "tsx examples/basic-anthropic-example.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardada2468/LLMTypeSafe.git"
  },
  "homepage": "https://github.com/ardada2468/LLMTypeSafe#readme",
  "bugs": {
    "url": "https://github.com/ardada2468/LLMTypeSafe/issues"
  }
}
