{
  "name": "@ts-dspy/core",
  "version": "0.5.1",
  "description": "Core library for building type-safe LLM applications with structured input/output signatures, runtime validation, and reasoning patterns in TypeScript",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai",
    "llm",
    "dspy",
    "typescript",
    "prompting",
    "structured-output",
    "structured-outputs",
    "json-schema",
    "zod",
    "validation",
    "type-safe",
    "ai-agents",
    "prompt-engineering",
    "tool-calling",
    "chain-of-thought",
    "llm-framework"
  ],
  "author": "Arnav Dadarya",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardada2468/LLMTypeSafe.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ardada2468/LLMTypeSafe#readme",
  "bugs": {
    "url": "https://github.com/ardada2468/LLMTypeSafe/issues"
  }
}
