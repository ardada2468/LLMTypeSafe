{
  "name": "@ts-dspy/openai",
  "version": "0.4.2",
  "description": "OpenAI provider for TS-DSPy - type-safe LLM interactions with structured outputs, streaming, and tool calling",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ts-dspy/core": "^0.4.2",
    "openai": "^6.9.0"
  },
  "keywords": [
    "ai",
    "openai",
    "llm",
    "dspy",
    "typescript"
  ],
  "author": "Arnav Dadarya",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardada2468/LLMTypeSafe.git",
    "directory": "packages/openai"
  },
  "homepage": "https://github.com/ardada2468/LLMTypeSafe#readme",
  "bugs": {
    "url": "https://github.com/ardada2468/LLMTypeSafe/issues"
  }
}
