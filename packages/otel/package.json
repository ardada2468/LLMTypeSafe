{
  "name": "@ts-dspy/otel",
  "version": "0.6.0",
  "description": "OpenTelemetry instrumentation for TS-DSPy - nested spans for modules, LM calls, and tools with GenAI semantic conventions",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ts-dspy/core": "^0.6.0"
  },
  "keywords": [
    "ai",
    "opentelemetry",
    "otel",
    "tracing",
    "observability",
    "genai",
    "llm",
    "dspy",
    "typescript"
  ],
  "author": "Arnav Dadarya",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardada2468/LLMTypeSafe.git",
    "directory": "packages/otel"
  },
  "homepage": "https://github.com/ardada2468/LLMTypeSafe#readme",
  "bugs": {
    "url": "https://github.com/ardada2468/LLMTypeSafe/issues"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "~1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0"
  }
}
